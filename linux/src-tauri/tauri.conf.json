{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GUPet",
  "version": "1.0.9",
  "identifier": "net.guteam.gupet",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "category": "Utility",
    "shortDescription": "A pixel pet that lives on your desktop",
    "longDescription": "GUPet is a tiny pixel pet that walks, sleeps, reacts to clicks, plays with skins and keeps you company on your Linux desktop.",
    "copyright": "GUTeam",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "depends": [
          "libxext6"
        ],
        "desktopTemplate": "desktop/gupet.desktop"
      },
      "rpm": {
        "depends": [
          "libXext"
        ],
        "desktopTemplate": "desktop/gupet.desktop"
      }
    }
  }
}
