{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GUPet",
  "version": "3.0.0",
  "identifier": "net.guteam.gupet.windows",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "publisher": "GUTeam",
    "category": "Utility",
    "shortDescription": "A pixel pet that lives on your desktop",
    "longDescription": "GUPet is a tiny pixel pet that walks, sleeps, reacts to clicks, plays with skins and keeps you company on your Windows desktop.",
    "copyright": "GUTeam",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Russian"
        ]
      }
    }
  }
}
